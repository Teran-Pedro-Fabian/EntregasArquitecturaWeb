    {
      "name": "02 Fila virtual",
      "item": [
        {
          "name": "Ingresar a fila virtual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ticket/cola/{{idEvento}}/entrar",
            "description": "Devuelve posición y habilitado; las compras solo pueden seguir si habilitado es true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": \"{{clienteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar posición",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ticket/cola/{{idEvento}}/posicion?idCliente={{clienteId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Compra general (cambia la base)",
      "item": [
        {
          "name": "Reservar entrada general",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/lugares/sectores/generales/reservar",
            "description": "IMPORTANTE: reemplazar variable idSectorGeneral por el número del sector válido; el JSON requiere valor numérico. Editar el Body si Postman tratara el valor como cadena.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSector\": {{idSectorGeneral}},\n  \"idCliente\": \"{{clienteId}}\",\n  \"cantidad\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const datos = pm.response.json();",
                  "  pm.collectionVariables.set(\"idReserva\", datos.idReserva);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Comprar entrada general",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ticket/comprar-general",
            "description": "IMPORTANTE: idSector e idReserva deben ser números en el JSON. No repetir compras sin comprobar cupos; no usar el mismo guid para reintento deliberado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": \"{{clienteId}}\",\n  \"idEvento\": \"{{idEvento}}\",\n  \"idSector\": {{idSectorGeneral}},\n  \"idReserva\": {{idReserva}},\n  \"cantidad\": 1,\n  \"medioPago\": \"TARJETA\",\n  \"claveIdempotencia\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Compra confirmada (201)\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const datos = pm.response.json();",
                  "  pm.collectionVariables.set(\"idCompra\", datos.idCompra);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar compra",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ticket/compras/{{idCompra}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Reintentar confirmación de compra pendiente",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ticket/compras/{{idCompra}}/reintentar",
            "description": "Usar solo ante estado PENDIENTE_CONFIRMACION, no genera un nuevo pago.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
