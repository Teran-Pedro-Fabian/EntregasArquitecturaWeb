    {
      "name": "01 Autenticación JWT",
      "item": [
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idUsuario\": \"{{clienteId}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const datos = pm.response.json();",
                  "  pm.collectionVariables.set(\"tokenCliente\", datos.token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
